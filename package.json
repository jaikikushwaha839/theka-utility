{
  "name": "dyno-clone",
  "version": "1.0.0",
  "description": "A Dyno-style moderation bot built with discord.js v14 and mongoose",
  "main": "dist/index.js",
  "type": "commonjs",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "deploy": "ts-node src/deploy-commands.ts"
  },
  "dependencies": {
    "discord.js": "^14.19.3",
    "mongoose": "^8.7.0",
    "dotenv": "^16.4.5",
    "ms": "^2.1.3"
  },
  "devDependencies": {
    "@types/node": "^22.7.4",
    "@types/ms": "^0.7.34",
    "typescript": "^5.6.2",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0"
  }
}
